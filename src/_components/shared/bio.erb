<bio class = "bio">
  <h3><%= @name %></h3>
  <strong><p><%= @jobtitle %></p></strong>
  <bio-inner class = "row">
    <div class = "column left-column">
      <img src="<%= relative_url @profilepicture %>">
    </div>
    <div class = "column right-column">
      <%= content %>
    </div>

  </bio-inner>
</bio>