<card class = "card">
  <h3><%= @title %></h3>
  <card-inner class = "row">
    <div class = "column left-column">
      <img src="<%= relative_url @cardimage %>" alt="<%= @alttext %>" />
    </div>
    <div class = "column right-column">
      <%= content %>
    </div>

  </card-inner>
  <a href="<%= @buttonlink %>"><button rel="noopener"><%= @buttontitle %></button></a>
</card>